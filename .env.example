# Environment variables consumed by Duke Strategies Deliverables.
#
# Copy to .env (never commit .env) and fill in real values.
# Remote MCPs (nl-gov-data, stromy-format) authenticate via per-user
# Microsoft Entra ID OAuth at first use — no client-side secrets; URLs
# are pinned in .agents/mcp.json.

# ms365 delivery broker — operator-portable token cache paths (see .agents/mcp.json)
MS365_TOKEN_CACHE=
MS365_SELECTED_ACCOUNT=
